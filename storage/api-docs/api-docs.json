{
    "openapi": "3.0.0",
    "info": {
        "title": "My Social Media API",
        "description": "API documentation for Social Media app",
        "contact": {
            "email": "support@example.com"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Local API Server"
        }
