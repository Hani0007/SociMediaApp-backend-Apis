                                        "post_id": {
                                            "type": "integer",
                                            "example": 21
                                        },
                                        "comments_count": {
                                            "type": "integer",
                                            "example": 5
                                        },
                                        "comments": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "comment_text": {
                                                        "type": "string",
                                                        "example": "Nice post!"
                                                    },
                                                    "user_id": {
                                                        "type": "integer",
                                                        "example": 3
                                                    },
                                                    "post_id": {
                                                        "type": "integer",
                                                        "example": 21
                                                    },
                                                    "created_at": {
                                                        "type": "string",
                                                        "example": "2025-09-04T10:15:30Z"
                                                    },
                                                    "updated_at": {
                                                        "type": "string",
                                                        "example": "2025-09-04T10:15:30Z"
                                                    },
                                                    "user": {
                                                        "properties": {
                                                            "id": {
                                                                "type": "integer",
                                                                "example": 3
                                                            },
                                                            "name": {
                                                                "type": "string",
                                                                "example": "Abdul Hanan"
                                                            }
                                                        },
                                                        "type": "object"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
